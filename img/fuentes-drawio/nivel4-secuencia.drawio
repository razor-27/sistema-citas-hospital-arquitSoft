arent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="660" as="sourcePoint"/><mxPoint x="420" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m15" value="15: retorna CitaDTO" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#222;fontSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="700" as="sourcePoint"/><mxPoint x="255" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m16" value="16: HTTP 201 Created (Comprobante Cita)" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#2E7D32;fontSize=10.5;dashed=1;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="740" as="sourcePoint"/><mxPoint x="110" y="740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m17" value="17 [Asíncrono]: Consumo de evento y envío WhatsApp/SMS" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666;fontSize=9.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="770" as="sourcePoint"/><mxPoint x="1350" y="770" as="targetPoint"/><Array as="points"><mxPoint x="1310" y="770"/><mxPoint x="1310" y="800"/><mxPoint x="1260" y="800"/></Array></mxGeometry></mxCell><mxCell id="boxNotes" value="&lt;b&gt;Garantías del Flujo de Reserva Atómica&lt;/b&gt;&lt;br&gt;• Paso 3 a 4: El candado distribuido en Redis evita que dos usuarios reserven el mismo cupo al mismo milisegundo (latencia &amp;lt; 10 ms).&lt;br&gt;• Paso 9 a 11: La actualización del slot y creación de la cita se ejecutan en una única transacción ACID en PostgreSQL.&lt;br&gt;• Paso 12 y 17: La notificación por WhatsApp se desacopla mediante RabbitMQ; no retarda la confirmación en pantalla del paciente (&amp;lt; 500 ms)." style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7B7B7;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="1280" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>