<mxfile host="app.diagrams.net"><diagram id="d" name="Principio DIP"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Principio de Inversión de Dependencias (DIP) – Módulo de Citas&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="800" height="24" as="geometry"/></mxCell><mxCell id="t2" value="Los módulos de alto nivel no dependen de los de bajo nivel. Ambos dependen de abstracciones." style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=11;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="42" width="800" height="20" as="geometry"/></mxCell><mxCell id="boxSin" value="&lt;b&gt;SIN DIP (Acoplamiento Rígido)&lt;/b&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E57373;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#C62828;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="400" height="240" as="geometry"/></mxCell><mxCell id="sUC" value="ReservarCitaUseCase&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;(Lógica de Negocio)&lt;/font&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E57373;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="120" width="220" height="50" as="geometry"/></mxCell><mxCell id="sPG" value="PostgresConnection / TypeORM&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;(Base de Datos SQL)&lt;/font&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E57373;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="230" width="220" height="50" as="geometry"/></mxCell><mxCell id="sArr" value="depende directamente de la BD" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C62828;fontSize=9.5;fontColor=#C62828;" edge="1" parent="1" source="sUC" target="sPG"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="boxCon" value="&lt;b&gt;CON DIP (Clean Architecture)&lt;/b&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#81C784;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="480" y="80" width="460" height="240" as="geometry"/></mxCell><mxCell id="cUC" value="ReservarCitaUseCase&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;(Capa Aplicación)&lt;/font&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="120" width="180" height="50" as="geometry"/></mxCell><mxCell id="cPort" value="&amp;laquo;interface&amp;raquo; CitaRepositoryPort&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;(Capa Dominio)&lt;/font&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="720" y="120" width="190" height="50" as="geometry"/></mxCell><mxCell id="cRepo" value="PostgresCitaRepository&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;(Capa Infraestructura)&lt;/font&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="230" width="190" height="50" as="geometry"/></mxCell><mxCell id="cArr1" value="depende de" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#2E7D32;fontSize=9.5;" edge="1" parent="1" source="cUC" target="cPort"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cArr2" value="implementa" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;dashed=1;strokeColor=#2E7D32;fontSize=9.5;" edge="1" parent="1" source="cRepo" target="cPort"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="botNote" value="&lt;b&gt;Beneficio del DIP en Citas Médicas:&lt;/b&gt;&lt;br&gt;El caso de uso de reserva puede probarse con un InMemoryCitaRepository en memoria sin levantar PostgreSQL ni depender de una base de datos real." style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7B7B7;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10.5;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="900" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>