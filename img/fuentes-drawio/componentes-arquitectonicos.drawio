<mxfile host="app.diagrams.net"><diagram id="d" name="Componentes Arquitectónicos"><mxGraphModel dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Componentes Arquitectónicos de Clean Architecture – Sistema de Citas&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="900" height="26" as="geometry"/></mxCell><mxCell id="t2" value="Hospital de Huamanga · Mapeo de responsabilidades, puertos de entrada/salida y flujo de control" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=12;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="900" height="20" as="geometry"/></mxCell><mxCell id="cPres" value="Capa de Presentación&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Controladores REST, Request/Response DTOs, Guards JWT&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5FA7;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="240" height="90" as="geometry"/></mxCell><mxCell id="cApp" value="Capa de Aplicación&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Casos de Uso (ReservarCita, CancelarCita), Orquestación Transaccional, Input Commands&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F3EC;strokeColor=#2F7D4F;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="280" height="90" as="geometry"/></mxCell><mxCell id="cDom" value="Capa de Dominio&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Entidades Cita y TurnoSlot, Value Objects, PoliticaReservaService, Puertos de Salida&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF3E3;strokeColor=#B7791F;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="280" height="90" as="geometry"/></mxCell><mxCell id="cInf" value="Capa de Infraestructura&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;PostgresCitaRepo, RedisLockAdapter, RabbitMQPublisher, SISAdapter&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1ECF9;strokeColor=#6D4AA8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="280" width="280" height="90" as="geometry"/></mxCell><mxCell id="arr1" value="Invoca Caso de Uso&lt;br&gt;(Command DTO)" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2F7D4F;fontSize=10;" edge="1" parent="1" source="cPres" target="cApp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arr2" value="Aplica Reglas&lt;br&gt;&amp; Consulta Puertos" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B7791F;fontSize=10;" edge="1" parent="1" source="cApp" target="cDom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arr3" value="Implementa Puertos&lt;br&gt;(Inversión Dependencias)" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;dashed=1;strokeColor=#6D4AA8;fontSize=10;" edge="1" parent="1" source="cInf" target="cDom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="boxNotes" value="&lt;b&gt;Aislamiento y Trazabilidad de los Componentes Arquitectónicos&lt;/b&gt;&lt;br&gt;1. El flujo de control nace en Presentación, viaja a Aplicación y consulta Dominio.&lt;br&gt;2. La dirección de las dependencias de código fuente apunta SIEMPRE hacia el Dominio (Inversión de Dependencias - DIP).&lt;br&gt;3. Los datos entre capas viajan encapsulados en DTOs inmutables para no exponer entidades a la vista ni tecnologías a la lógica clínica." style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7B7B7;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10.5;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="960" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>