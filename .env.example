# Aplicación
NODE_ENV=development
PORT=3000

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://citas_user:citas_pass@localhost:5432/citas_hospital

# Caché y Bloqueo Distribuido Redis
REDIS_URL=redis://localhost:6379
LOCK_TTL_MS=10000
CACHE_TTL_SEC=60

# Mensajería Asíncrona RabbitMQ
RABBITMQ_URL=amqp://citas_mq:citas_mq_pass@localhost:5672

# Seguridad JWT
JWT_SECRET=cambiar-este-secreto-en-produccion-min-32-chars
JWT_EXPIRES_IN=1h
